# Configuração de Banco de Dados PostgreSQL (Local ou Nuvem)
# Formato padrão: postgresql://[usuario]:[senha]@[host]:[porta]/[nome_do_banco]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maristory"

# Componentes individuais da conexão (alternativa):
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="postgres"
PGDATABASE="maristory"

# Configurações da Proprietária (Opcional - substitua no seu arquivo .env local ou nas variáveis de ambiente da nuvem)
# O arquivo .env real NUNCA é enviado ao GitHub (já incluso no .gitignore)
OWNER_NAME="Proprietária"
OWNER_EMAIL="proprietaria@maristory.local"
OWNER_PASSWORD="sua_senha_segura"
AUTH_SECRET_SALT="maristory_secret_salt"